{
  "name": "@waffled/api",
  "version": "0.15.3",
  "private": true,
  "description": "Waffled backend API (lambda-api), written in TS, bundled to JS with esbuild. Same code runs as a container locally (server) and on AWS Lambda (lambda).",
  "main": "dist/lambda.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix .",
    "format": "oxfmt --config ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "token": "tsx scripts/mint-token.ts",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "check:migrations": "node scripts/check-migration-numbers.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "anylist:import": "tsx --env-file-if-exists=.env scripts/admin.ts import-anylist"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "ical.js": "^2.2.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "lambda-api": "^1.4.0",
    "luxon": "^3.7.2",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.13.0",
    "protobufjs": "^7.6.6",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.12",
      "minimatch": "10.2.5"
    }
  }
}
